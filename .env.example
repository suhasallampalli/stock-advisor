# ---------------------------------------------------------------------------
# Copy to .env and fill in.  NEVER commit .env.
# ---------------------------------------------------------------------------

# --- Claude (daily commentary) ---------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
ADVISOR_LLM_MODEL=claude-opus-5

# --- API / auth ----------------------------------------------------------
# HS256 signing key for JWTs.  Generate: python -c "import secrets;print(secrets.token_urlsafe(64))"
API_SECRET_KEY=
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
# SQLite by default; point at Postgres in production, e.g.
#   postgresql+psycopg://user:pass@host/advisor
DATABASE_URL=sqlite:///./data/advisor.db
# Fernet key encrypting each user's broker credentials at rest.
# Generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
SECRETS_ENC_KEY=
ALLOW_REGISTRATION=true
# Comma-separated allowed browser origins for CORS ("*" for any).
CORS_ORIGINS=*
# Where to bounce the browser after Google login (optional). If set, the
# callback 302s to  <FRONTEND_URL>#access_token=...&refresh_token=...
FRONTEND_URL=

# --- Sign in with Google (OAuth2 / OIDC) --------------------------------
# Create an OAuth client (type: Web application) at
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# --- Email (Gmail SMTP with an App Password) ------------------------------
# Create at https://myaccount.google.com/apppasswords  (needs 2FA on)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=asuhas.106@gmail.com
SMTP_APP_PASSWORD=xxxxxxxxxxxxxxxx
EMAIL_FROM=asuhas.106@gmail.com
EMAIL_TO=asuhas.106@gmail.com

# --- Which brokers are active (comma separated: zerodha,upstox,angelone) ---
ADVISOR_BROKERS=zerodha,upstox,angelone

# --- Zerodha Kite Connect -------------------------------------------------
# access_token is obtained daily via scripts/zerodha_login.py -> written to
# data/zerodha_token.json.  api_key/api_secret come from developers.kite.trade
KITE_API_KEY=
KITE_API_SECRET=

# --- Upstox -------------------------------------------------------------
# access_token obtained daily via scripts/upstox_login.py -> data/upstox_token.json
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://127.0.0.1:8550/callback

# --- Angel One SmartAPI (fully automatable via TOTP secret) ---------------
ANGEL_API_KEY=
ANGEL_CLIENT_ID=
ANGEL_MPIN=
ANGEL_TOTP_SECRET=
